  "nodes": [
    {
      "id": "goal.single-persisted-contract",
      "kind": "goal",
      "title": "Keep one persisted contract between authoring and rendering",
      "summary": "The JSON reasoning-map artifact should remain the only stored source of truth shared by the skill and the visualizer.",
      "status": "active",
      "confidence": 0.98,
      "importance": 0.99,
      "completeness": 0.93,
      "visibility": "normal",
      "relevance": 0.99,
      "deficiencies": []
    },
    {
      "id": "decision.top-level-graph-shape",
      "kind": "decision",
      "title": "Use explicit graph-level fields instead of a generic metadata bucket",
      "summary": "The persisted artifact should carry named top-level fields such as graph identity, title, scope, status, nodes, edges, and optional related graph references.",
      "status": "active",
      "confidence": 0.97,
      "importance": 0.97,
      "completeness": 0.94,
      "visibility": "normal",
      "relevance": 0.98,
      "deficiencies": []
    },
    {
      "id": "claim.required-top-level-fields",
      "kind": "claim",
      "role": "support",
      "assertion_kind": "inference",
      "title": "A persisted graph should expose graph_id, title, scope, status, nodes, and edges directly",
      "summary": "Fresh agents and downstream tools should not have to infer the contract from an unstructured metadata container.",
      "status": "active",
      "confidence": 0.95,
      "importance": 0.94,
      "completeness": 0.92,
      "visibility": "normal",
      "relevance": 0.95,
      "deficiencies": []
    },
    {
      "id": "decision.rootless-not-originless-metadata",
      "kind": "decision",
      "title": "Keep graphs rootless and avoid persisted origin-node requirements",
      "summary": "Problems may raise more problems and maps may sprawl, so the contract should not require origin nodes or a central root-like pointer.",
      "status": "active",
      "confidence": 0.97,
      "importance": 0.95,
      "completeness": 0.94,
      "visibility": "normal",
      "relevance": 0.96,
      "deficiencies": []
    },
    {
      "id": "risk.generic-metadata-drift",
      "kind": "risk",
      "title": "A generic metadata bucket invites parallel contract drift",
      "summary": "Different agents may invent different metadata keys and silently create incompatible persisted shapes.",
      "status": "active",
      "confidence": 0.94,
      "importance": 0.9,
      "completeness": 0.86,
      "visibility": "normal",
      "relevance": 0.92,
      "deficiencies": []
    },
    {
      "id": "risk.origin-node-anti-pattern",
      "kind": "risk",
      "title": "Origin-node identifiers reintroduce an implied center",
      "summary": "Persisted fields like origin node lists subtly push the model back toward root-based reasoning even when the graph should remain rootless.",
      "status": "active",
      "confidence": 0.93,
      "importance": 0.87,
      "completeness": 0.84,
      "visibility": "normal",
      "relevance": 0.9,
      "deficiencies": []
    },
    {
      "id": "decision.node-minimum-contract",
      "kind": "decision",
      "title": "Require id, kind, title, status, and deficiencies on meaningful nodes",
      "summary": "These fields make sparse reasoning explicit and keep the graph legible to a fresh agent without over-modeling every node.",
      "status": "active",
      "confidence": 0.98,
      "importance": 0.95,
      "completeness": 0.95,
      "visibility": "normal",
      "relevance": 0.96,
      "deficiencies": []
    },
    {
      "id": "decision.edge-first-structure",
      "kind": "decision",
      "title": "Treat edges as first-class persisted records",
      "summary": "Meaningful relationships should be explicit objects rather than buried in node summaries or inferred by renderers.",
      "status": "active",
      "confidence": 0.98,
      "importance": 0.95,
      "completeness": 0.94,
      "visibility": "normal",
      "relevance": 0.96,
      "deficiencies": []
    },
    {
      "id": "decision.lifecycle-visibility-separation",
      "kind": "decision",
      "title": "Separate truth, relevance, and display through status, relevance, and visibility",
      "summary": "Weak or abandoned branches should be preserved non-destructively without dominating common views.",
      "status": "active",
      "confidence": 0.96,
      "importance": 0.92,
      "completeness": 0.9,
      "visibility": "normal",
      "relevance": 0.93,
      "deficiencies": []
    },
    {
      "id": "decision.latent-memory-guided-expansion",
      "kind": "decision",
      "title": "Let latent memory activation decide when long-tail branches should stop growing",
      "summary": "A branch should keep expanding only while a future fresh agent is likely to retrieve it and use it to change action, risk assessment, or problem framing.",
      "status": "active",
      "confidence": 0.95,
      "importance": 0.91,
      "completeness": 0.87,
      "visibility": "normal",
      "relevance": 0.94,
      "deficiencies": []
    },
    {
      "id": "risk.long-tail-surface-area",
      "kind": "risk",
      "title": "Long-tail branches can add surface area without adding usable future context",
      "summary": "If a branch stops helping a future agent make better choices, continued expansion turns the map into archival debris instead of latent memory.",
      "status": "active",
      "confidence": 0.93,
      "importance": 0.86,
      "completeness": 0.82,
      "visibility": "normal",
      "relevance": 0.9,
      "deficiencies": []
    },
    {
      "id": "claim.aggregate-low-activation-leaves",
      "kind": "claim",
      "role": "mitigation",
      "assertion_kind": "inference",
      "title": "Low-activation sibling leaves should usually be aggregated instead of expanded independently",
      "summary": "If several small branches point in the same direction, one compressed node preserves more value than many thin leaves.",
      "status": "active",
      "confidence": 0.92,
      "importance": 0.8,
      "completeness": 0.84,
      "visibility": "normal",
      "relevance": 0.86,
      "deficiencies": []
    },
    {
      "id": "gap.schema-map-still-needs-pressure-test",
      "kind": "gap",
      "title": "The contract map still needs validation against fresh no-context agents",
      "summary": "The value of this map is not proven until it reduces schema drift in clean-room reimplementation tests.",
